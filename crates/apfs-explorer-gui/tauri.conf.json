{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenAPFS",
  "version": "0.1.0",
  "identifier": "io.github.hachimiku39.openapfs",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": null
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenAPFS",
        "width": 760,
        "height": 600,
        "minWidth": 480,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "OpenAPFS contributors",
    "category": "Utility",
    "shortDescription": "Mount and browse APFS (Apple File System) volumes on Windows.",
    "longDescription": "APFS Explorer mounts Apple File System (APFS) USB drives and disk images on Windows as a drive letter (via WinFsp) and lets you browse them read-only. Single-EXE layout: the GUI (apfs-explorer.exe) spawns the elevated mount helper (apfs-mount.exe) installed alongside it.",
    "resources": {
      "apfs-mount.exe": "apfs-mount.exe",
      "../../LICENSE": "LICENSE",
      "../../NOTICE.md": "NOTICE.md",
      "../../README.md": "README.md",
      "../../ARCHITECTURE.md": "ARCHITECTURE.md",
      "../../TESTING.md": "TESTING.md",
      "../../SECURITY.md": "SECURITY.md",
      "../../licenses/WinFsp-2.1.txt": "licenses/WinFsp-2.1.txt"
    },
    "windows": {
      "wix": {
        "language": "en-US",
        "fragmentPaths": [
          "wix/winfsp-launcher.wxs"
        ],
        "componentGroupRefs": [
          "WinFspLauncherClass"
        ],
        "upgradeCode": "5b091da2-3fb1-45be-a356-33a3559b8a6f"
      }
    }
  }
}
