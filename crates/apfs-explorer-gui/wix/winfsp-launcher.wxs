<?xml version="1.0" encoding="UTF-8"?>
<!--
  Registers the apfs-mount WinFsp Launcher service class so the GUI (elevated
  once when it opens) can start/stop a globally-visible, read-only APFS mount
  via launchctl without a per-mount UAC prompt.

  Written in the 32-bit registry view under SOFTWARE\WinFsp\Services (where the WinFsp launcher
  reads its service classes). ForceDeleteOnUninstall removes the class on
  uninstall. The CommandLine is read-only by construction (it carries no
  writable flag): %1 is the physical drive index, %2 is the drive letter the
  GUI chose, %3 the volume's slot in the container. The snapshot class adds
  %4, the snapshot's xid, and is read-only too.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="WinFspLauncherClass" Directory="INSTALLDIR">
      <Component Id="ApfsMountLauncherClass" Guid="*" Win64="no">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\WinFsp\Services\apfs-mount"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="Executable"
                         Value="[INSTALLDIR]apfs-mount.exe" KeyPath="yes" />
          <RegistryValue Type="string" Name="CommandLine"
                         Value="--drive %1 --mount %2 --volume-index %3 --wait-for-kill" />
          <!-- Administrators and SYSTEM only. WD (Everyone) let any user on
               the machine ask the launcher to start this service, and the
               launcher runs it as SYSTEM with Credentials=0, so an ordinary
               account could obtain raw access to any physical drive by
               number - read-write for the -rw service, and reading a disk
               raw bypasses every file permission on it either way. -->
          <RegistryValue Type="string" Name="Security"
                         Value="D:P(A;;RPWPLC;;;BA)(A;;RPWPLC;;;SY)" />
          <RegistryValue Type="integer" Name="JobControl" Value="1" />
          <RegistryValue Type="integer" Name="Credentials" Value="0" />
        </RegistryKey>
      </Component>
      <!-- Snapshot class: a volume as one of its snapshots holds it, always
           read-only (apfs-mount ignores any writable request for one). -->
      <Component Id="ApfsMountLauncherClassSnap" Guid="*" Win64="no">
        <RegistryKey Root="HKLM"
                     Key="SOFTWARE\WinFsp\Services\apfs-mount-snap"
                     ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string" Name="Executable"
                         Value="[INSTALLDIR]apfs-mount.exe" KeyPath="yes" />
          <RegistryValue Type="string" Name="CommandLine"
                         Value="--drive %1 --mount %2 --volume-index %3 --snapshot-xid %4 --wait-for-kill" />
          <!-- Administrators and SYSTEM only, as for the other classes. -->
          <RegistryValue Type="string" Name="Security"
                         Value="D:P(A;;RPWPLC;;;BA)(A;;RPWPLC;;;SY)" />
          <RegistryValue Type="integer" Name="JobControl" Value="1" />
          <RegistryValue Type="integer" Name="Credentials" Value="0" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
